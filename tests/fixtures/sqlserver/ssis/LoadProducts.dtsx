<?xml version="1.0"?>
<DTS:Executable xmlns:DTS="www.microsoft.com/SqlServer/Dts" DTS:ObjectName="LoadProducts" DTS:ExecutableType="Microsoft.Package">
  <DTS:Executables>
    <DTS:Executable DTS:refId="Package\Clean product feed" DTS:ObjectName="Clean product feed" DTS:ExecutableType="Microsoft.ScriptTask">
      <DTS:ObjectData>
        <ScriptProject Name="ST_CleanFeed" Language="CSharp" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Load products" DTS:ObjectName="Load products" DTS:ExecutableType="Microsoft.Pipeline">
      <DTS:ObjectData>
        <pipeline version="1">
          <components>
            <component refId="Product file" componentClassID="Microsoft.FlatFileSource" name="Product file">
              <properties>
                <property dataType="System.String" name="FileName">\\fileshare\feeds\products.csv</property>
              </properties>
            </component>
            <component refId="Staging Products" componentClassID="Microsoft.OLEDBDestination" name="Staging Products">
              <properties>
                <property dataType="System.String" name="OpenRowset">[stg].[Product_Load]</property>
              </properties>
            </component>
          </components>
        </pipeline>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Load inventory" DTS:ObjectName="Load inventory" DTS:ExecutableType="Microsoft.ExecuteSQLTask">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" SQLTask:Connection="SalesDW" SQLTask:SqlStatementSource="INSERT INTO stg.Inventory_Load (ProductKey, StoreKey, OnHandQty, SnapshotDate) SELECT ProductKey, StoreKey, OnHandQty, CAST(GETDATE() AS DATE) FROM WMS.dbo.StockLevels" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
</DTS:Executable>
