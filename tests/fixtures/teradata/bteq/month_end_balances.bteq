.LOGON tdprod/etl_batch,S3cr3tPassw0rd;
DATABASE EDW;

-- Month-end account balances (regulatory return source)
DELETE FROM EDW.ACCOUNT_BAL WHERE BAL_MONTH = ADD_MONTHS(CURRENT_DATE - EXTRACT(DAY FROM CURRENT_DATE) + 1, -1);
.IF ERRORCODE <> 0 THEN .GOTO FAILED

INSERT INTO EDW.ACCOUNT_BAL (BAL_MONTH, CUSTOMER_ID, BALANCE)
SELECT ADD_MONTHS(CURRENT_DATE - EXTRACT(DAY FROM CURRENT_DATE) + 1, -1), f.CUSTOMER_ID, SUM(f.AMOUNT) / COUNT(DISTINCT f.SALE_DATE)
FROM EDW.SALES_FACT f
JOIN EDW.CUSTOMER c ON c.CUSTOMER_ID = f.CUSTOMER_ID
WHERE c.CUSTOMER_NAME = 'ACME'
GROUP BY f.CUSTOMER_ID;
.IF ERRORCODE <> 0 THEN .GOTO FAILED
.QUIT 0

.LABEL FAILED
.QUIT 8
