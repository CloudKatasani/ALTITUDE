.LOGON tdprod/etl_batch,S3cr3tPassw0rd;
.SET ERROROUT STDOUT
DATABASE EDW;

/* Daily sales load: full refresh of the staging copy, then append to the fact */
DELETE FROM EDW.STG_SALES ALL;
.IF ERRORCODE <> 0 THEN .GOTO LOAD_FAILED

INSERT INTO EDW.STG_SALES
SELECT * FROM EDW_LANDING.POS_SALES_FEED;
.IF ERRORCODE <> 0 THEN .GOTO LOAD_FAILED
.IF ACTIVITYCOUNT = 0 THEN .GOTO NOTHING_TO_DO

INSERT INTO EDW.SALES_FACT (SALE_ID, SALE_DATE, CUSTOMER_ID, PRODUCT_ID, QTY, AMOUNT)
SELECT s.SALE_ID, s.SALE_DATE, s.CUSTOMER_ID, s.PRODUCT_ID, s.QTY, s.AMOUNT
FROM EDW.STG_SALES s
WHERE NOT EXISTS (SELECT 1 FROM EDW.SALES_FACT f WHERE f.SALE_ID = s.SALE_ID);
.IF ERRORCODE <> 0 THEN .GOTO LOAD_FAILED

EXEC EDW.M_REFRESH_AGG;
.IF ERRORCODE <> 0 THEN .GOTO LOAD_FAILED

.LABEL NOTHING_TO_DO
.LOGOFF
.QUIT 0

.LABEL LOAD_FAILED
.LOGOFF
.QUIT 8
