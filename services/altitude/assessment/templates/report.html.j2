<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{PRODUCT_NAME}} — Estate assessment</title>
<style>
  :root { --primary: {{COLOR_PRIMARY}}; --accent: {{COLOR_ACCENT}}; --warn: {{COLOR_WARN}}; --surface: {{COLOR_SURFACE}}; --text: {{COLOR_TEXT}}; }
  body { font-family: system-ui, sans-serif; color: var(--text); background: var(--surface); margin: 0 auto; max-width: 1100px; padding: 24px 16px; }
  h1, h2 { color: var(--primary); }
  table { border-collapse: collapse; width: 100%; margin: 8px 0 24px; font-size: 14px; }
  th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid rgba(0, 0, 0, .1); vertical-align: top; }
  th { color: var(--primary); }
  code { font-size: 12px; }
  .review { color: var(--warn); font-weight: 600; }
  .kpi { display: inline-block; margin: 0 24px 16px 0; }
  .kpi b { display: block; font-size: 24px; color: var(--accent); }
  footer { font-size: 12px; opacity: .8; }
</style>
</head>
<body>
<h1>{{PRODUCT_NAME}} — Estate assessment: {{ s.source }}</h1>
<p>Computed from sealed snapshot <code>{{ snapshot_id }}</code> (harvest <code>{{ s.harvest_snapshot_id }}</code>,
as of {{ s.as_of }}) with rubric <code>{{ s.rubric_version }}</code>. Prepared by {{COMPANY_NAME}}.</p>

<div>
  <span class="kpi"><b>{{ s.objects }}</b>objects</span>
  <span class="kpi"><b>{{ s.dispositions.get("retire", 0) }}</b>retire</span>
  <span class="kpi"><b>{{ s.dispositions.get("rewrite", 0) }}</b>rewrite</span>
  <span class="kpi"><b>{{ s.review_items }}</b>awaiting review</span>
  <span class="kpi"><b>{{ "%.2f"|format(s.anti_pattern_credits_month) }}</b>est. credits / month at risk</span>
</div>
<p>Drift-risk scan: <b>{{ s.drift_scan.status }}</b>{% if s.drift_scan.reason %} — {{ s.drift_scan.reason }}{% endif %}</p>

<h2>Awaiting review</h2>
<table><tr><th>Object</th><th>Proposed</th><th>Confidence</th><th>Rationale</th></tr>
{% for r in review %}<tr><td><code>{{ r.fq_name }}</code></td><td class="review">{{ r.disposition }}</td><td>{{ "%.2f"|format(r.confidence) }}</td><td>{{ r.rationale }}</td></tr>
{% else %}<tr><td colspan="4">None.</td></tr>{% endfor %}
</table>

<h2>Retire candidates</h2>
<table><tr><th>Object</th><th>Type</th><th>Last used</th><th>Confidence</th><th>Rationale</th></tr>
{% for r in retire %}<tr><td><code>{{ r.fq_name }}</code></td><td>{{ r.object_type }}</td><td>{{ r.last_used_at or "never" }}</td><td>{{ "%.2f"|format(r.confidence) }}</td><td>{{ r.rationale }}</td></tr>
{% else %}<tr><td colspan="5">None.</td></tr>{% endfor %}
</table>

<h2>Rewrite candidates</h2>
<table><tr><th>Object</th><th>Type</th><th>Complexity</th><th>Rationale</th></tr>
{% for r in rewrite %}<tr><td><code>{{ r.fq_name }}</code></td><td>{{ r.object_type }}</td><td>{{ r.complexity_score }} ({{ r.complexity_band }})</td><td>{{ r.rationale }}</td></tr>
{% else %}<tr><td colspan="4">None.</td></tr>{% endfor %}
</table>

<h2>Top anti-patterns by estimated credit impact</h2>
<table><tr><th>Pattern</th><th>Object</th><th>Line</th><th>Credits / month</th><th>Evidence</th><th>Recommendation</th></tr>
{% for h in hits %}<tr><td>{{ h.pattern_id }} {{ h.pattern }}</td><td><code>{{ h.fq_name }}</code></td><td>{{ h.line }}</td><td>{{ "%.4f"|format(h.credits_month) }}</td><td><code>{{ h.snippet }}</code></td><td>{{ h.recommendation }}</td></tr>
{% else %}<tr><td colspan="6">No anti-patterns detected.</td></tr>{% endfor %}
</table>

<h2>Drift risk</h2>
{% if s.drift_scan.status == "skipped" %}<p>Not assessed: {{ s.drift_scan.reason }}.</p>
{% else %}<table><tr><th>Issue</th><th>Severity</th><th>Object</th><th>Line</th><th>Message</th></tr>
{% for d in drift %}<tr><td>{{ d.issue_id }}</td><td>{{ d.severity }}</td><td><code>{{ d.fq_name }}</code></td><td>{{ d.line }}</td><td>{{ d.message }}</td></tr>
{% else %}<tr><td colspan="5">No drift risks detected.</td></tr>{% endfor %}
</table>{% endif %}

<footer>Dispositions are proposals: items below the review threshold have no effect until a named reviewer approves them.
Credit impacts are estimates (runs/month × credits/run × size factor). Contact: {{SUPPORT_EMAIL}}.</footer>
</body>
</html>
