{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Package D suggestion record (canonical, Section 6.5) — published in suggestions.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "snapshot_id", "check_id", "domain", "waf_pillar", "title", "evidence_refs", "affected_objects",
               "value", "risk_reduction", "effort", "confidence", "rationale", "remediation", "kpis_to_watch",
               "priority", "status", "reviewer"],
  "properties": {
    "id": {"type": "string", "pattern": "^SUG-[0-9A-F]{8}$"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "check_id": {"type": "string", "pattern": "^DX-[A-Z]+-\\d{2}$"},
    "domain": {"type": "string", "pattern": "^D([1-9]|10)$"},
    "waf_pillar": {"enum": ["security_governance", "operational_excellence", "reliability", "performance_efficiency", "cost_optimization"]},
    "title": {"type": "string", "minLength": 3},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^EV-[A-Z]+-[0-9A-F]{8}$"}},
    "affected_objects": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annualised_usd", "method"],
      "properties": {
        "annualised_usd": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["p50", "conservative"],
          "properties": {"p50": {"type": "number", "minimum": 0}, "conservative": {"type": "number", "minimum": 0}}
        },
        "method": {"type": "string", "minLength": 10}
      }
    },
    "risk_reduction": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["likelihood", "impact", "score", "residual_score", "method"],
      "properties": {
        "likelihood": {"type": "integer", "minimum": 1, "maximum": 5},
        "impact": {"type": "integer", "minimum": 1, "maximum": 5},
        "score": {"type": "integer", "minimum": 1, "maximum": 25},
        "residual_score": {"type": "integer", "minimum": 0, "maximum": 25},
        "method": {"type": "string"}
      }
    },
    "effort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "hours_p50"],
      "properties": {"size": {"enum": ["XS", "S", "M", "L", "XL"]}, "hours_p50": {"type": "number", "exclusiveMinimum": 0}}
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "rationale": {"type": "string", "minLength": 10},
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "artifact_ref", "autonomy", "rollback_ref"],
      "properties": {
        "type": {"enum": ["sql", "terraform", "dbt"]},
        "artifact_ref": {"type": "string", "minLength": 1},
        "autonomy": {"enum": ["L0", "L1", "L2", "L3"]},
        "rollback_ref": {"type": "string", "minLength": 1}
      }
    },
    "kpis_to_watch": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^KPI-[A-Z]+-\\d{3}$"}},
    "priority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quadrant", "rank"],
      "properties": {"quadrant": {"enum": ["quick_win", "strategic", "hygiene", "defer"]}, "rank": {"type": "integer", "minimum": 1}}
    },
    "status": {"enum": ["proposed", "accepted", "implemented", "value_realised", "rejected"]},
    "reviewer": {"type": ["string", "null"]}
  }
}
