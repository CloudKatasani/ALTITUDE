{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ETL and scheduler known issues (Sections 11.1, 11.2)",
  "x-altitude-globs": ["etl/known_issues.yaml", "schedulers/known_issues.yaml"],
  "type": "object",
  "required": ["known_issues"],
  "additionalProperties": false,
  "properties": {
    "last_verified": {"type": "string"},
    "verified_by": {"type": "string"},
    "known_issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "severity", "detector", "fix"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^(ETL-[A-Z]+-\\d{2}|SCH-\\d{2})$"},
          "tool": {"type": "string"},
          "title": {"type": "string"},
          "severity": {"enum": ["S1", "S2", "S3", "S4"]},
          "detector": {"type": "string"},
          "fix": {"type": "string"}
        }
      }
    }
  }
}
