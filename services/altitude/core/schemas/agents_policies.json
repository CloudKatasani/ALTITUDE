{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent tenant policies, error signatures and behaviour-change bundles",
  "x-altitude-globs": ["agents/tenant_policies.yaml", "agents/error_signatures.yaml", "agents/behaviour_changes.yaml"],
  "type": "object",
  "required": ["version"],
  "additionalProperties": false,
  "$defs": {
    "level": {"enum": ["L0", "L1", "L2", "L3"]},
    "fqname": {"type": "string", "pattern": "^[A-Z_][A-Z0-9_$]*(\\.[A-Z_][A-Z0-9_$]*){0,2}$"}
  },
  "properties": {
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "tenants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "tenant_id", "autonomy_caps", "break_glass_users", "idempotent_tasks", "approvers",
                     "mfa_authentication_policy", "quarantine_tag", "system_roles"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^TP-[A-Z0-9-]+$"},
          "tenant_id": {"type": "string"},
          "description": {"type": "string"},
          "autonomy_caps": {"type": "object", "additionalProperties": {"$ref": "#/$defs/level"}},
          "break_glass_users": {"type": "array", "items": {"$ref": "#/$defs/fqname"}},
          "idempotent_tasks": {"type": "array", "items": {"$ref": "#/$defs/fqname"}},
          "approvers": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
          "mfa_authentication_policy": {"$ref": "#/$defs/fqname"},
          "quarantine_tag": {"$ref": "#/$defs/fqname"},
          "system_roles": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "root_cause", "pattern", "retryable", "confidence", "fix"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^ERR-[A-Z0-9-]+$"},
          "root_cause": {"type": "string"},
          "pattern": {"type": "string"},
          "retryable": {"type": "boolean"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "fix": {"type": "string"}
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "bundle", "title", "category", "summary", "signatures", "test_guidance", "last_verified"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^BCB-[A-Z0-9_-]+$"},
          "bundle": {"type": "string"},
          "title": {"type": "string"},
          "category": {"type": "string"},
          "summary": {"type": "string"},
          "signatures": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["kind"],
              "additionalProperties": false,
              "properties": {
                "kind": {"enum": ["query_text", "view_definition", "sql"]},
                "pattern": {"type": "string"},
                "sql": {"type": "string", "pattern": "^\\s*SELECT\\s"}
              },
              "oneOf": [{"required": ["pattern"]}, {"required": ["sql"]}]
            }
          },
          "test_guidance": {"type": "string"},
          "last_verified": {"type": "string", "format": "date"}
        }
      }
    }
  }
}
