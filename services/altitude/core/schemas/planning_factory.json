{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Factory state machine (Section 9.2)",
  "x-altitude-globs": ["planning/factory.yaml"],
  "type": "object",
  "required": ["version", "initial", "states", "transitions", "agent_confidence_threshold_ref"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "description": {"type": "string"},
    "initial": {"type": "string"},
    "lanes": {"type": "array", "items": {"type": "string"}},
    "states": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["state", "label"],
        "additionalProperties": false,
        "properties": {"state": {"type": "string", "pattern": "^[a-z][a-z_]*$"}, "label": {"type": "string"}}
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "additionalProperties": false,
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "actor_types": {"type": "array", "items": {"type": "string", "enum": ["human", "agent", "system"]}},
          "requires_gate": {"type": "string"},
          "when_disposition": {"type": "string", "enum": ["keep", "retire", "rewrite"]},
          "rework": {"type": "boolean"}
        }
      }
    },
    "agent_confidence_threshold_ref": {"type": "string"}
  }
}
