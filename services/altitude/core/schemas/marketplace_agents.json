{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Marketplace agents",
  "x-altitude-globs": ["marketplace/agents.yaml"],
  "type": "object",
  "required": ["marketplace_agents"],
  "additionalProperties": false,
  "properties": {"marketplace_agents": {"type": "array", "minItems": 1, "items": {
    "type": "object", "required": ["id", "name", "description", "kind", "products", "role", "audience", "golden_questions", "sample_questions"],
    "additionalProperties": false,
    "properties": {
      "id": {"type": "string", "pattern": "^MA-[A-Z0-9-]+$"}, "name": {"type": "string"}, "description": {"type": "string"},
      "kind": {"enum": ["cortex_analyst", "cortex_search"]},
      "products": {"type": "array", "items": {"type": "string", "pattern": "^DP-"}},
      "semantic_view": {"type": "string"}, "search_service": {"type": "string"},
      "provided_by": {"enum": ["package_o"]},
      "role": {"type": "string"}, "audience": {"type": "array", "items": {"type": "string"}},
      "golden_questions": {"type": "integer", "minimum": 0},
      "sample_questions": {"type": "array", "items": {"type": "string"}}},
    "allOf": [
      {"if": {"properties": {"kind": {"const": "cortex_analyst"}}}, "then": {"required": ["semantic_view"]}},
      {"if": {"properties": {"kind": {"const": "cortex_search"}}}, "then": {"required": ["search_service"]}}]}}}
}
