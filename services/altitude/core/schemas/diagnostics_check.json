{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Package D diagnostic check catalogue",
  "x-altitude-globs": ["diagnostics/checks/*.yaml"],
  "type": "object",
  "required": ["version", "checks"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}}
  },
  "$defs": {
    "ref": {"type": "string", "pattern": "^rubric\\.[a-z0-9_.]+$"},
    "param": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "threshold_ref": {"$ref": "#/$defs/ref"},
        "ref": {"$ref": "#/$defs/ref"},
        "value": {"type": ["string", "array", "boolean"], "items": {"type": "string"}}
      }
    },
    "check": {
      "type": "object",
      "required": ["id", "title", "description", "domain", "waf_pillar", "severity", "confidence_class", "detector",
                   "evidence", "value", "effort", "title_template", "rationale_template", "remediation",
                   "kpis_to_watch", "last_verified"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^DX-(COST|PERF|REL|SEC|GOV|OPS|ARCH|BI|AI)-\\d{2}$"},
        "title": {"type": "string", "minLength": 3},
        "description": {"type": "string", "minLength": 10},
        "domain": {"type": "string", "pattern": "^D([1-9]|10)$"},
        "also_scores": {"type": "array", "items": {"type": "string", "pattern": "^D([1-9]|10)$"}},
        "waf_pillar": {"enum": ["security_governance", "operational_excellence", "reliability", "performance_efficiency", "cost_optimization"]},
        "severity": {"enum": ["critical", "high", "medium", "low"]},
        "confidence_class": {"enum": ["high", "medium", "low"]},
        "detector": {
          "type": "object",
          "required": ["requires", "inputs", "cluster_by", "params", "signals", "rule"],
          "additionalProperties": false,
          "properties": {
            "requires": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Z_]+$"}},
            "inputs": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
            "cluster_by": {"enum": ["query_signature", "warehouse", "dashboard", "pipeline", "owner", "object", "theme"]},
            "params": {"type": "object", "additionalProperties": {"$ref": "#/$defs/param"}},
            "signals": {"type": "string", "minLength": 20},
            "rule": {"type": "string", "minLength": 3}
          }
        },
        "evidence": {
          "type": "object",
          "required": ["kind", "fields"],
          "additionalProperties": false,
          "properties": {
            "kind": {"type": "string", "pattern": "^[A-Z]{2,5}$"},
            "fields": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"}}
          }
        },
        "value": {
          "type": "object",
          "required": ["method"],
          "additionalProperties": false,
          "properties": {
            "method": {"type": "string", "minLength": 10},
            "p50": {"type": "string"},
            "conservative": {"type": "string"},
            "factors": {"type": "object", "additionalProperties": {"$ref": "#/$defs/ref"}}
          },
          "dependentRequired": {"p50": ["conservative"], "conservative": ["p50"]}
        },
        "risk": {
          "type": "object",
          "required": ["likelihood_ref", "impact_ref", "method"],
          "additionalProperties": false,
          "properties": {
            "likelihood_ref": {"$ref": "#/$defs/ref"},
            "impact_ref": {"$ref": "#/$defs/ref"},
            "method": {"type": "string", "minLength": 10}
          }
        },
        "effort": {
          "type": "object",
          "required": ["size"],
          "additionalProperties": false,
          "properties": {"size": {"enum": ["XS", "S", "M", "L", "XL"]}}
        },
        "title_template": {"type": "string", "minLength": 3},
        "rationale_template": {"type": "string", "minLength": 10},
        "remediation": {
          "type": "object",
          "required": ["type", "autonomy", "template", "rollback"],
          "additionalProperties": false,
          "properties": {
            "type": {"enum": ["sql", "terraform", "dbt"]},
            "autonomy": {"enum": ["L0", "L1", "L2", "L3"]},
            "template": {"type": "string", "minLength": 10},
            "rollback": {"type": "string", "minLength": 10}
          }
        },
        "kpis_to_watch": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^KPI-(COST|PERF|REL|SEC|GOV|USE|AI|PHI)-\\d{3}$"}},
        "last_verified": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      },
      "anyOf": [
        {"properties": {"value": {"required": ["p50"]}}},
        {"required": ["risk"]}
      ]
    }
  }
}
