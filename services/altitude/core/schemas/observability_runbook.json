{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Package O runbook (Section 7.6)",
  "x-altitude-globs": ["observability/runbooks/*.yaml"],
  "type": "object",
  "required": ["id", "title", "alert_classes", "owner_role", "autonomy", "linked_kpis", "steps", "escalation",
               "verification"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^RB-[A-Z]+-[A-Z0-9-]+$"},
    "title": {"type": "string"},
    "alert_classes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "owner_role": {"type": "string"},
    "autonomy": {"enum": ["L0", "L1", "L2", "L3"]},
    "linked_kpis": {"type": "array", "items": {"type": "string", "pattern": "^KPI-"}},
    "linked_checks": {"type": "array", "items": {"type": "string"}},
    "steps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["action"], "additionalProperties": false,
        "properties": {"action": {"type": "string"}, "query": {"type": "string"}}
      }
    },
    "escalation": {"type": "string"},
    "verification": {"type": "string"}
  }
}
