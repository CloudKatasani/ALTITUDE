{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Package O ask-the-platform golden questions",
  "x-altitude-globs": ["observability/golden_questions.yaml"],
  "type": "object",
  "required": ["version", "fixture", "questions"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "fixture": {
      "type": "object", "required": ["account_name", "profile", "end_date", "days"], "additionalProperties": false,
      "properties": {
        "account_name": {"type": "string"},
        "profile": {"enum": ["seeded", "clean"]},
        "end_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "days": {"type": "integer", "minimum": 1}
      }
    },
    "questions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "question", "expected"], "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^GQ-OBS-[A-Z0-9]+$"},
          "question": {"type": "string", "minLength": 5},
          "expected": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "kpi_id": {"type": "string", "pattern": "^KPI-"},
              "dimension": {"type": "string"},
              "window_days": {"type": "integer", "minimum": 1},
              "ranking": {"type": "boolean"},
              "answer_contains": {"type": "array", "items": {"type": "string"}},
              "refuse": {"type": "boolean"}
            },
            "oneOf": [{"required": ["kpi_id"]}, {"required": ["refuse"]}]
          }
        }
      }
    }
  }
}
