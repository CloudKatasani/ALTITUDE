{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Package O CURATED model (conformed facts and dimensions)",
  "x-altitude-globs": ["observability/curated.yaml"],
  "type": "object",
  "required": ["version", "objects"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "kind", "description", "sql"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^(DIM|FACT|CFG|SNAPSHOT)_[A-Z0-9_]+$|^SNAPSHOT_HARVEST$"},
          "kind": {"enum": ["dim", "fact", "helper"]},
          "grain": {"type": "array", "items": {"type": "string"}},
          "description": {"type": "string"},
          "sql": {"type": "string", "minLength": 10},
          "sql_snowflake": {"type": "string", "minLength": 10}
        }
      }
    }
  }
}
