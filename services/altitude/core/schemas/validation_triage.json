{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mismatch triage root-cause signatures",
  "x-altitude-globs": ["validation/triage_signatures.yaml"],
  "type": "object",
  "required": ["version", "signatures"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "description": {"type": "string"},
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "signature", "description", "issue_by_dialect", "confidence_ref"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^SIG-[A-Z0-9-]+$"},
          "signature": {"type": "string", "pattern": "^[a-z_]+$"},
          "description": {"type": "string"},
          "issue_by_dialect": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[A-Z]{2}-\\d{2}$"}},
          "confidence_ref": {"type": "string", "pattern": "^rubric\\."}
        }
      }
    }
  }
}
