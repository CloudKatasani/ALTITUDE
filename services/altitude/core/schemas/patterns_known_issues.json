{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pattern Library: known-issues register (Appendix A)",
  "x-altitude-globs": ["dialects/*/known_issues.yaml"],
  "type": "object",
  "required": ["dialect", "version", "known_issues"],
  "additionalProperties": false,
  "properties": {
    "dialect": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "description": {"type": "string"},
    "known_issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source_dialect", "title", "severity", "checklist_items", "symptoms", "detection",
                     "fix_patterns", "tests", "validation_normalisation", "decision_required", "last_verified",
                     "verified_by"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z]{2}-\\d{2}$"},
          "source_dialect": {"type": "string"},
          "applies_to": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "title": {"type": "string", "minLength": 5},
          "severity": {"enum": ["S1", "S2", "S3", "S4"]},
          "checklist_items": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 12}},
          "symptoms": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "detection": {
            "type": "object",
            "required": ["type", "detector"],
            "additionalProperties": false,
            "properties": {
              "type": {"enum": ["static", "profile", "static_and_profile"]},
              "static_rule": {"type": "string"},
              "profile_rule": {"type": "string"},
              "detector": {"type": "string", "pattern": "^(static|profile)\\.[a-z0-9_]+$"},
              "extra_detectors": {"type": "array", "items": {"type": "string", "pattern": "^(static|profile)\\.[a-z0-9_]+$"}}
            }
          },
          "fix_patterns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "description", "applies_when"],
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string", "pattern": "^FX-[A-Z]{2}-\\d{2}-[A-Z]$"},
                "description": {"type": "string"},
                "applies_when": {"type": "string"}
              }
            }
          },
          "tests": {"type": "array", "items": {"type": "string", "pattern": "^TC-[A-Z]{2}-\\d{2}-\\d{3}$"}, "minItems": 1},
          "validation_normalisation": {"type": "string"},
          "mismatch_signatures": {"type": "array", "items": {"type": "string"}},
          "decision_required": {"type": "boolean"},
          "last_verified": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "verified_by": {"type": "string"}
        }
      }
    }
  }
}
