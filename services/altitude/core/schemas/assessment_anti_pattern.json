{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anti-pattern detector catalogue (Section 31)",
  "x-altitude-globs": ["anti_patterns/*.yaml"],
  "type": "object",
  "required": ["anti_patterns"],
  "additionalProperties": false,
  "properties": {
    "description": {"type": "string"},
    "anti_patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "title", "severity", "applies_to", "detector", "credits_per_run_ref",
                     "recommendation", "last_verified"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^AP-[0-9]{2}$"},
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "title": {"type": "string"},
          "severity": {"type": "string", "enum": ["S1", "S2", "S3", "S4"]},
          "applies_to": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "enum": ["table", "view", "procedure", "function", "package", "trigger",
                                                  "macro", "script", "etl_job", "schedule", "report"]}
          },
          "detector": {"type": "string", "description": "Name of an executable detector in altitude.assessment.anti_patterns.DETECTORS"},
          "size_sensitive": {"type": "boolean"},
          "credits_per_run_ref": {"type": "string", "pattern": "^rubric\\."},
          "threshold_ref": {"type": "string", "pattern": "^rubric\\."},
          "recommendation": {"type": "string"},
          "known_issues": {"type": "array", "items": {"type": "string"}},
          "last_verified": {"type": "string", "format": "date"}
        }
      }
    }
  }
}
