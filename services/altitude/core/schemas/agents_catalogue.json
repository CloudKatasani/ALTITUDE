{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent fleet catalogue (Section 18.2)",
  "x-altitude-globs": ["agents/catalogue.yaml"],
  "type": "object",
  "required": ["version", "agents"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "number", "name", "implemented", "trigger", "purpose", "max_autonomy", "guardrails",
                     "kpi", "tool_scope", "action_types", "service_identity"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^AG-[A-Z0-9-]+$"},
          "number": {"type": "integer", "minimum": 1},
          "name": {"type": "string"},
          "implemented": {"type": "boolean"},
          "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
          "prompt_template": {"type": "string", "pattern": "^[a-z_/]+@\\d+$"},
          "trigger": {
            "type": "object",
            "required": ["type", "description"],
            "additionalProperties": false,
            "properties": {
              "type": {"enum": ["schedule", "event", "continuous"]},
              "cron": {"type": "string"},
              "event": {"type": "string"},
              "description": {"type": "string"}
            }
          },
          "purpose": {"type": "string"},
          "max_autonomy": {"enum": ["L0", "L1", "L2", "L3"]},
          "autonomy_by_action": {"type": "object", "additionalProperties": {"enum": ["L0", "L1", "L2", "L3"]}},
          "guardrails": {"type": "array", "items": {"type": "string"}},
          "forbidden_statements": {"type": "array", "items": {"type": "string"}},
          "kpi": {"type": "string"},
          "tool_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z_0-9]+$"}},
          "action_types": {"type": "array", "items": {"type": "string", "pattern": "^[a-z_]+\\.[a-z_]+$"}},
          "service_identity": {
            "type": "object",
            "required": ["user", "role", "warehouse"],
            "additionalProperties": false,
            "properties": {
              "user": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
              "role": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
              "warehouse": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
            }
          }
        },
        "if": {"properties": {"implemented": {"const": true}}},
        "then": {"required": ["version", "prompt_template"]}
      }
    }
  }
}
