{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pattern Library: source-to-Snowflake conversion mappings",
  "x-altitude-globs": ["dialects/*/mappings.yaml"],
  "type": "object",
  "required": ["dialect", "version", "mappings"],
  "additionalProperties": false,
  "properties": {
    "dialect": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "description": {"type": "string"},
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "source_construct", "target_construct", "last_verified", "verified_by"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^MAP-[A-Z]{2}-\\d{3}$"},
          "category": {"enum": ["ddl", "types", "sql", "procedural", "scripting", "loading", "scheduling", "etl", "bi",
                                "integration", "workload"]},
          "source_construct": {"type": "string"},
          "target_construct": {"type": "string"},
          "note": {"type": "string"},
          "related_issues": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]{2}-\\d{2}$"}},
          "last_verified": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "verified_by": {"type": "string"}
        }
      }
    }
  }
}
