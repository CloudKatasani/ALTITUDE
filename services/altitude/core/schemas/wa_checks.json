{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Well-Architected baseline checks (Section 14.9 format)",
  "x-altitude-globs": ["well_architected/checks/*.yaml"],
  "type": "object",
  "required": ["version", "checks"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "pillar", "waf_pillar", "section", "title", "query", "severity", "rationale", "remediation"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^WA-[A-Z]+-\\d{3}$"},
          "pillar": {"enum": ["organisation", "identity", "network", "compute", "cost", "engineering", "observability", "ai"]},
          "waf_pillar": {"enum": ["security_governance", "operational_excellence", "reliability", "performance_efficiency",
                                  "cost_optimization"]},
          "section": {"type": "string", "pattern": "^14\\.[1-8]$"},
          "title": {"type": "string"},
          "query": {"type": "string", "pattern": "OBJECT_NAME"},
          "query_ref": {"type": "string", "pattern": "^generated/foundation/sql/wa_[a-z]+_\\d{3}\\.sql$"},
          "threshold_ref": {"type": "string"},
          "params": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^rubric\\."}},
          "severity": {"enum": ["critical", "high", "medium", "low"]},
          "rationale": {"type": "string"},
          "remediation": {
            "type": "object",
            "required": ["auto_fix_available", "autonomy", "playbook"],
            "additionalProperties": false,
            "properties": {
              "auto_fix_available": {"type": "boolean"},
              "autonomy": {"enum": ["L0", "L1", "L2", "L3"]},
              "playbook": {"type": "string", "pattern": "^PB-[A-Z0-9-]+$"}
            }
          }
        }
      }
    }
  }
}
