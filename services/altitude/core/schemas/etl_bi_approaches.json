{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BI & semantic-layer migration approaches (Section 11.3)",
  "x-altitude-globs": ["bi/*.yaml"],
  "type": "object",
  "required": ["approaches"],
  "additionalProperties": false,
  "properties": {
    "best_practices": {"type": "array", "items": {"type": "string"}},
    "approaches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "tool", "approach", "validation"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^BI-[A-Z]+$"},
          "tool": {"type": "string"},
          "approach": {"type": "string"},
          "decisions": {"type": "array", "items": {"type": "string"}},
          "validation": {"type": "array", "items": {"enum": ["screenshot_diff", "pixel_diff", "kpi_value_diff"]}, "minItems": 1}
        }
      }
    }
  }
}
